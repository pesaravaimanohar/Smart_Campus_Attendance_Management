package com.college.smartattendance.service;

import com.college.smartattendance.entity.*;
import com.college.smartattendance.repository.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;

/**
 * Service for managing semester-wise faculty-subject assignments
 * This is dynamic and changes every semester
 */
@Service
public class SubjectAssignmentService {

    @Autowired
    private FacultySubjectMapRepository assignmentRepository;

    @Autowired
    private FacultyRepository facultyRepository;

    @Autowired
    private SubjectRepository subjectRepository;

    @Autowired
    private FacultySubjectEligibilityRepository eligibilityRepository;

    @Autowired
    private AuditService auditService;

    /**
     * Assign a subject to a faculty for a semester
     */
    @Transactional
    public FacultySubjectMap assignSubject(
            Long facultyId,
            Long subjectId,
            String section,
            String academicYear,
            Integer semester,
            Long assignedBy) {

        // Check if faculty exists
        Faculty faculty = facultyRepository.findById(facultyId)
                .orElseThrow(() -> new RuntimeException("Faculty not found: " + facultyId));

        // Check if subject exists
        Subject subject = subjectRepository.findById(subjectId)
                .orElseThrow(() -> new RuntimeException("Subject not found: " + subjectId));

        // Verify eligibility
        if (!eligibilityRepository.existsByFacultyIdAndSubjectId(facultyId, subjectId)) {
            throw new RuntimeException("Faculty " + faculty.getFacultyId() +
                    " is not eligible to teach " + subject.getName());
        }

        // Check if assignment already exists for this section
        List<FacultySubjectMap> existing = assignmentRepository
                .findBySubjectIdAndSection(subjectId, section);

        if (!existing.isEmpty()) {
            throw new RuntimeException("Subject already assigned to another faculty for section " + section);
        }

        // Create assignment
        FacultySubjectMap assignment = new FacultySubjectMap();
        assignment.setFaculty(faculty);
        assignment.setSubject(subject);
        assignment.setSection(section);
        assignment.setAssignedBy(assignedBy);
        assignment.setAssignedAt(LocalDateTime.now());
        assignment.setLocked(false);

        assignment = assignmentRepository.save(assignment);

        // Audit log
        auditService.logAction(
                assignedBy,
                "FacultySubjectMap",
                assignment.getId(),
                "ASSIGNED",
                null,
                "Faculty " + faculty.getFacultyId() + " assigned to " +
                        subject.getName() + " (Section " + section + ")",
                null);

        return assignment;
    }

    /**
     * Unassign a subject from a faculty
     * Only allowed if not locked
     */
    @Transactional
    public void unassignSubject(Long assignmentId, Long unassignedBy) {
        FacultySubjectMap assignment = assignmentRepository.findById(assignmentId)
                .orElseThrow(() -> new RuntimeException("Assignment not found: " + assignmentId));

        // Check if locked
        if (assignment.isLocked()) {
            throw new RuntimeException("Cannot unassign - assignment is locked");
        }

        String facultyId = assignment.getFaculty().getFacultyId();
        String subjectName = assignment.getSubject().getName();
        String section = assignment.getSection();

        assignmentRepository.delete(assignment);

        // Audit log
        auditService.logAction(
                unassignedBy,
                "FacultySubjectMap",
                assignmentId,
                "UNASSIGNED",
                "Faculty " + facultyId + " - " + subjectName + " (Section " + section + ")",
                null,
                null);
    }

    /**
     * Lock an assignment (prevent changes)
     * Used after semester starts or attendance marking begins
     */
    @Transactional
    public void lockAssignment(Long assignmentId, Long lockedBy) {
        FacultySubjectMap assignment = assignmentRepository.findById(assignmentId)
                .orElseThrow(() -> new RuntimeException("Assignment not found: " + assignmentId));

        assignment.setLocked(true);
        assignmentRepository.save(assignment);

        // Audit log
        auditService.logAction(
                lockedBy,
                "FacultySubjectMap",
                assignmentId,
                "LOCKED",
                "unlocked",
                "locked",
                null);
    }

    /**
     * Unlock an assignment (admin only)
     */
    @Transactional
    public void unlockAssignment(Long assignmentId, Long unlockedBy) {
        FacultySubjectMap assignment = assignmentRepository.findById(assignmentId)
                .orElseThrow(() -> new RuntimeException("Assignment not found: " + assignmentId));

        assignment.setLocked(false);
        assignmentRepository.save(assignment);

        // Audit log
        auditService.logAction(
                unlockedBy,
                "FacultySubjectMap",
                assignmentId,
                "UNLOCKED",
                "locked",
                "unlocked",
                null);
    }

    /**
     * Get all assignments for a faculty
     */
    public List<FacultySubjectMap> getFacultyAssignments(Long facultyId) {
        return assignmentRepository.findByFacultyId(facultyId);
    }

    /**
     * Get all assignments for a subject
     */
    public List<FacultySubjectMap> getSubjectAssignments(Long subjectId) {
        return assignmentRepository.findBySubjectId(subjectId);
    }

    /**
     * Get assignment by subject and section
     */
    public List<FacultySubjectMap> getAssignmentBySubjectAndSection(Long subjectId, String section) {
        return assignmentRepository.findBySubjectIdAndSection(subjectId, section);
    }

    /**
     * Get faculty workload (count of assigned subjects)
     */
    public int getFacultyWorkload(Long facultyId) {
        return assignmentRepository.findByFacultyId(facultyId).size();
    }

    /**
     * Bulk assign subjects to a faculty
     */
    @Transactional
    public int bulkAssignSubjects(
            Long facultyId,
            List<Long> subjectIds,
            String section,
            String academicYear,
            Integer semester,
            Long assignedBy) {

        int count = 0;

        for (Long subjectId : subjectIds) {
            try {
                assignSubject(facultyId, subjectId, section, academicYear, semester, assignedBy);
                count++;
            } catch (Exception e) {
                // Log error but continue
                System.err.println("Failed to assign subject " + subjectId + ": " + e.getMessage());
            }
        }

        return count;
    }

    /**
     * Reassign a subject to a different faculty
     * Only works if current assignment is not locked
     */
    @Transactional
    public FacultySubjectMap reassignSubject(
            Long assignmentId,
            Long newFacultyId,
            Long reassignedBy) {

        FacultySubjectMap oldAssignment = assignmentRepository.findById(assignmentId)
                .orElseThrow(() -> new RuntimeException("Assignment not found: " + assignmentId));

        if (oldAssignment.isLocked()) {
            throw new RuntimeException("Cannot reassign - assignment is locked");
        }

        Long subjectId = oldAssignment.getSubject().getId();
        String section = oldAssignment.getSection();

        // Delete old assignment
        assignmentRepository.delete(oldAssignment);

        // Create new assignment (will verify eligibility)
        return assignSubject(newFacultyId, subjectId, section, null, null, reassignedBy);
    }
}
